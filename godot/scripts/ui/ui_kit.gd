class_name UIKit
extends RefCounted
## Dark-fantasy ARPG theme (PoE2 / Diablo IV direction) + builder helpers.
## Type roles:  display = Cinzel (carved Roman capitals) for titles, buttons and names;
##              body    = EB Garamond for descriptions and lore;
##              label   = Marcellus SC for small-caps tags and section labels;
##              num     = Alegreya Sans heavy for numbers, HUD values and damage.
## Frames are 9-slice textures generated by tools/make_art.py (forged bronze on weathered slate).

const BG := Color("0a090c")
const TEXT := Color("e9e1cf")        # parchment white
const DIM := Color("9b917f")         # aged ink
const GOLD := Color("e8b54e")        # forged gold, the one accent
const EMBER := Color("ff7a32")
const BLOOD := Color("b3242c")
const RIFT := Color("8fd8ff")

static var touch_mode := -1        # -1: ask the device, 0: force desktop layout (tests), 1: force touch layout

## True when the touch layout (on-screen buttons, no action bar) should be used.
static func is_touch() -> bool:
	if touch_mode >= 0: return touch_mode == 1
	return DisplayServer.is_touchscreen_available() or bool(Save.opt("force_touch_ui"))

static var _fonts := {}
static func font(role: String) -> Font:
	if _fonts.has(role): return _fonts[role]
	var file: String = {
		"display": "cinzel-latin-700-normal.woff2", "display_heavy": "cinzel-latin-900-normal.woff2",
		"deco": "cinzel-decorative-latin-900-normal.woff2", "body": "eb-garamond-latin-500-normal.woff2",
		"italic": "eb-garamond-latin-400-italic.woff2", "label": "marcellus-sc-latin-400-normal.woff2",
		"num": "alegreya-sans-latin-800-normal.woff2", "num_heavy": "alegreya-sans-latin-900-normal.woff2",
	}.get(role, "eb-garamond-latin-500-normal.woff2")
	var f: Font = load("res://fonts/" + file)
	_fonts[role] = f
	return f

static func tex(name: String) -> Texture2D:
	return load("res://ui/" + name + ".png")

static func nine(name: String, margin: int, content: Vector4 = Vector4(16, 10, 16, 10), modulate: Color = Color.WHITE) -> StyleBoxTexture:
	var s := StyleBoxTexture.new()
	s.texture = tex(name)
	s.texture_margin_left = margin; s.texture_margin_right = margin
	s.texture_margin_top = margin; s.texture_margin_bottom = margin
	s.content_margin_left = content.x; s.content_margin_top = content.y
	s.content_margin_right = content.z; s.content_margin_bottom = content.w
	s.modulate_color = modulate
	return s

static func theme() -> Theme:
	var t := Theme.new()
	t.default_font = font("body")
	t.default_font_size = 21
	var pad := Vector4(22, 12, 22, 12)
	t.set_stylebox("normal", "Button", nine("btn_normal", 16, pad))
	t.set_stylebox("focus", "Button", nine("btn_hover", 16, pad, Color(1, 1, 1, 0.0)))
	t.set_stylebox("hover", "Button", nine("btn_hover", 16, pad))
	t.set_stylebox("pressed", "Button", nine("btn_pressed", 16, pad))
	t.set_stylebox("disabled", "Button", nine("btn_disabled", 16, pad))
	t.set_font("font", "Button", font("display"))
	t.set_font_size("font_size", "Button", 19)
	t.set_color("font_color", "Button", TEXT)
	t.set_color("font_hover_color", "Button", Color("fff1d2"))
	t.set_color("font_pressed_color", "Button", GOLD)
	t.set_color("font_focus_color", "Button", TEXT)
	t.set_color("font_disabled_color", "Button", Color("5c5650"))
	t.set_color("font_outline_color", "Button", Color(0, 0, 0, 0.85))
	t.set_constant("outline_size", "Button", 4)
	t.set_stylebox("panel", "PanelContainer", nine("panel", 64, Vector4(34, 34, 34, 30)))
	t.set_stylebox("panel", "Panel", nine("panel", 64))
	t.set_color("font_color", "Label", TEXT)
	t.set_color("font_outline_color", "Label", Color(0, 0, 0, 0.8))
	t.set_constant("separation", "VBoxContainer", 10)
	t.set_constant("separation", "HBoxContainer", 10)
	var inset := StyleBoxFlat.new()                       # tabs sit inside an ornate sheet: a quiet inset, not a second frame
	inset.bg_color = Color(0.03, 0.025, 0.035, 0.75)
	inset.border_color = Color(0.55, 0.4, 0.22, 0.55)
	inset.set_border_width_all(1)
	inset.set_corner_radius_all(4)
	inset.content_margin_left = 18; inset.content_margin_right = 18; inset.content_margin_top = 14; inset.content_margin_bottom = 14
	t.set_stylebox("panel", "TabContainer", inset)
	t.set_stylebox("tab_selected", "TabContainer", nine("btn_hover", 16, Vector4(18, 8, 18, 8)))
	t.set_stylebox("tab_unselected", "TabContainer", nine("btn_normal", 16, Vector4(18, 8, 18, 8)))
	t.set_stylebox("tab_hovered", "TabContainer", nine("btn_hover", 16, Vector4(18, 8, 18, 8)))
	t.set_font("font", "TabContainer", font("display"))
	t.set_font_size("font_size", "TabContainer", 17)
	t.set_color("font_selected_color", "TabContainer", GOLD)
	t.set_color("font_unselected_color", "TabContainer", DIM)
	t.set_stylebox("background", "ProgressBar", nine("bar", 14, Vector4(6, 6, 6, 6)))
	var fill := StyleBoxFlat.new()
	fill.bg_color = BLOOD
	fill.set_corner_radius_all(3)
	fill.expand_margin_left = -5; fill.expand_margin_right = -5; fill.expand_margin_top = -5; fill.expand_margin_bottom = -5
	t.set_stylebox("fill", "ProgressBar", fill)
	var sl := StyleBoxFlat.new()
	sl.bg_color = Color(0.08, 0.07, 0.08); sl.border_color = Color("8a6232"); sl.set_border_width_all(2); sl.set_corner_radius_all(4)
	sl.content_margin_top = 4; sl.content_margin_bottom = 4
	t.set_stylebox("slider", "HSlider", sl)
	var tip := nine("panel", 64, Vector4(18, 14, 18, 14))
	t.set_stylebox("panel", "TooltipPanel", tip)
	t.set_font("font", "TooltipLabel", font("body"))
	t.set_color("font_color", "TooltipLabel", TEXT)
	var scroll := StyleBoxFlat.new()
	scroll.bg_color = Color(0.6, 0.45, 0.25, 0.5); scroll.set_corner_radius_all(3)
	t.set_stylebox("grabber", "VScrollBar", scroll)
	t.set_stylebox("grabber_highlight", "VScrollBar", scroll)
	t.set_stylebox("scroll", "VScrollBar", StyleBoxEmpty.new())
	return t

## role: body | display | display_heavy | label | num | italic | deco
static func label(txt: String, size: int = 20, col: Color = TEXT, wrap: bool = false, role: String = "body") -> Label:
	var l := Label.new()
	l.text = txt
	l.add_theme_font_override("font", font(role))
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", col)
	if role.begins_with("display") or role == "deco" or size >= 28:
		l.add_theme_constant_override("outline_size", maxi(4, size / 7))
		l.add_theme_constant_override("shadow_offset_y", 2)
		l.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.7))
	if wrap:
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	return l

## A carved title with an ornamental rule under it.
static func title(txt: String, size: int = 40) -> VBoxContainer:
	var v := vbox(2)
	var l := label(txt.to_upper(), size, GOLD, false, "display_heavy")
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	v.add_child(l)
	v.add_child(divider())
	return v

static func divider() -> TextureRect:
	var d := TextureRect.new()
	d.texture = tex("divider")
	d.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	d.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	d.custom_minimum_size = Vector2(0, 22)
	d.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return d

static func section(txt: String) -> Label:
	return label(txt.to_upper(), 16, DIM, false, "label")

static func button(txt: String, cb: Callable, min_h: int = 56) -> Button:
	var b := Button.new()
	b.text = txt
	b.custom_minimum_size = Vector2(0, min_h)
	b.pressed.connect(func(): Sfx.play("click"); cb.call())
	return b

## A selectable tile (hero, stage, endgame mode): silver frame tinted by `tint`, gold when selected.
## title in Cinzel, sub-line in Garamond italic. Returns the Button; content is laid out inside it.
static func tile(title_txt: String, sub: String, cb: Callable, tint: Color = Color.WHITE, selected: bool = false, min_h: int = 92, left: bool = false, title_col: Color = Color(0, 0, 0, 0)) -> Button:
	var b := Button.new()
	b.custom_minimum_size = Vector2(0, min_h)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var base_t := Color(0.75, 0.72, 0.68).lerp(tint, 0.35)
	var sel_t := Color("f2c76a")
	var pad := Vector4(16, 12, 16, 12)
	b.add_theme_stylebox_override("normal", nine("tile", 24, pad, sel_t if selected else base_t))
	b.add_theme_stylebox_override("hover", nine("tile", 24, pad, sel_t.lightened(0.15) if selected else base_t.lightened(0.35)))
	b.add_theme_stylebox_override("pressed", nine("tile", 24, pad, sel_t))
	b.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	b.add_theme_stylebox_override("disabled", nine("tile", 24, pad, Color(0.35, 0.33, 0.32)))
	var v := vbox(2)
	v.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	v.offset_left = 18; v.offset_right = -18; v.offset_top = 5; v.offset_bottom = -6
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var t := label(title_txt, 20, GOLD if selected else (title_col if title_col.a > 0.0 else TEXT), false, "display")
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT if left else HORIZONTAL_ALIGNMENT_CENTER
	t.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	t.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(t)
	if sub != "":
		var s := label(sub, 15, DIM, true, "italic")
		s.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT if left else HORIZONTAL_ALIGNMENT_CENTER
		s.mouse_filter = Control.MOUSE_FILTER_IGNORE
		v.add_child(s)
	b.add_child(v)
	b.pressed.connect(func(): Sfx.play("click"); cb.call())
	b.set_meta("title_label", t)
	return b

static func vbox(sep: int = 10) -> VBoxContainer:
	var v := VBoxContainer.new()
	v.add_theme_constant_override("separation", sep)
	return v

static func hbox(sep: int = 10) -> HBoxContainer:
	var h := HBoxContainer.new()
	h.add_theme_constant_override("separation", sep)
	return h

static func panel(child: Control) -> PanelContainer:
	var p := PanelContainer.new()
	p.add_child(child)
	return p

static func bar(col: Color, h: int = 16) -> ProgressBar:
	var b := ProgressBar.new()
	b.show_percentage = false
	b.custom_minimum_size = Vector2(0, h)
	b.max_value = 1.0
	b.step = 0.0
	var f := StyleBoxFlat.new()
	f.bg_color = col
	f.set_corner_radius_all(3)
	f.expand_margin_left = -5; f.expand_margin_right = -5; f.expand_margin_top = -5; f.expand_margin_bottom = -5
	b.add_theme_stylebox_override("fill", f)
	return b

## Full-screen dimmed overlay hosting a centred, scrollable ornate panel.
static func sheet(parent: Control, max_w: int = 980) -> VBoxContainer:
	var dim := ColorRect.new()
	dim.color = Color(0.02, 0.015, 0.02, 0.78)
	parent.add_child(dim)
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var m := MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		m.add_theme_constant_override("margin_" + side, 14)
	parent.add_child(m)
	m.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var cc := CenterContainer.new()
	m.add_child(cc)
	var vs := parent.get_viewport_rect().size
	var p := PanelContainer.new()
	p.custom_minimum_size = Vector2(mini(max_w, int(vs.x) - 28), 0)
	cc.add_child(p)
	var sc := ScrollContainer.new()
	sc.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	p.add_child(sc)
	var v := vbox(12)
	v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.add_child(v)
	var maxh := float(vs.y) - 120.0                     # the panel hugs its content and scrolls only when taller than the screen
	v.minimum_size_changed.connect(func(): sc.custom_minimum_size.y = minf(v.get_combined_minimum_size().y, maxh))
	return v

static func clear(n: Node) -> void:
	for c in n.get_children():
		c.queue_free()
